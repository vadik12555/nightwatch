# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored — never commit real secrets.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Hostnames/IPs the UI and API are reached by (comma-separated). Add your domain or server IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS, e.g. https://nightwatch.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 when the site is served over HTTPS
DJANGO_SECURE_COOKIES=0
DJANGO_TIME_ZONE=Europe/Moscow

# First admin, created on start if missing (log in with these, then change the password)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- PostgreSQL (docker compose builds DATABASE_URL from these) -------------
POSTGRES_DB=nightwatch
POSTGRES_USER=nightwatch
# URL-safe characters only: it is embedded into DATABASE_URL
POSTGRES_PASSWORD=change-me-db-password

# Outside Docker you can point Django at any database instead:
# DATABASE_URL=postgres://user:pass@localhost:5432/nightwatch
# REDIS_URL=redis://localhost:6379/0

# --- NightWatch -------------------------------------------------------------
# Base URL agents use to reach the backend (shown in the install command).
# Empty = taken from the browser's address bar.
NIGHTWATCH_PUBLIC_URL=
# Agent silent longer than this = server offline (+ critical alert)
NIGHTWATCH_OFFLINE_AFTER_SECONDS=120
# How often Celery beat evaluates alert rules
NIGHTWATCH_ALERTS_INTERVAL_SECONDS=30
NIGHTWATCH_INGEST_RATE=30/min
NIGHTWATCH_METRICS_RETENTION_DAYS=30
NIGHTWATCH_LOGS_RETENTION_DAYS=14
# 1 = create demo servers on first start and keep them alive with synthetic data
DJANGO_SEED_DEMO=1
NIGHTWATCH_DEMO_MODE=1

# --- Telegram (stage 2) --------------------------------------------------------
# Token from @BotFather. Empty = bot and notifications disabled, everything else works.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (for the t.me deep link on the Telegram page)
TELEGRAM_BOT_USERNAME=

# --- AI (stage 3): any OpenAI-compatible API --------------------------------------
# Empty LLM_API_KEY = AI features disabled. OpenAI example:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Must return 1024-dim vectors: text-embedding-3-* (asked for 1024) or bge-m3
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Local Ollama on the Docker host instead (free, data never leaves your servers):
#   ollama pull qwen2.5:3b && ollama pull bge-m3
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=300
# RAG: how many runbook chunks to use and how close they must be (cosine distance)
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.6
# Weekly AI report: Mondays at this hour (DJANGO_TIME_ZONE)
NIGHTWATCH_WEEKLY_REPORT_HOUR=9

# Port Nginx listens on, on the host
NGINX_PORT=80
LOG_LEVEL=INFO
