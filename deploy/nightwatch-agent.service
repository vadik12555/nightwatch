# systemd unit for the NightWatch agent. Installed by agent/install.sh to
# /etc/systemd/system/nightwatch-agent.service.
[Unit]
Description=NightWatch monitoring agent
Documentation=https://github.com/vadik12555/nightwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unprivileged system user; install.sh adds it to systemd-journal/adm to read logs.
User=nightwatch
Group=nightwatch
ExecStart=/opt/nightwatch-agent/venv/bin/python /opt/nightwatch-agent/nightwatch_agent.py --config /etc/nightwatch/agent.yaml
Restart=always
RestartSec=10
# Creates /var/lib/nightwatch-agent owned by the service user (log positions live there).
StateDirectory=nightwatch-agent

# Hardening: the agent only reads system info and writes its own state.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
